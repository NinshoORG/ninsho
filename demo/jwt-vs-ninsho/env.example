# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# Postgres for user accounts (any Postgres works; Neon is fine).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis for Ninsho sessions. Use a dedicated instance.
REDIS_URL=redis://127.0.0.1:6380

PORT=3100

# Optional. Without it, a random JWT signing key is made at each start,
# so restarting the server signs everyone out of the JWT side.
# JWT_SECRET=
