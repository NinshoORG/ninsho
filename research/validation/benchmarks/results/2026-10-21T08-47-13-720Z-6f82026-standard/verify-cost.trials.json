    },
    "store.ninsho.get": {
      "group": "store-lookup",
      "checks": "RedisStore.get (ioredis GET behind Ninsho’s store wrapper)."
    },
    "store.ninsho.exists": {
      "group": "store-lookup",
      "checks": "RedisStore.exists (ioredis EXISTS behind Ninsho’s store wrapper)."
    },
    "verify.ninsho-opaque.redis": {
      "group": "comparable",
      "checks": "SHA-256 + Redis GET + record parse + expiry + binding."
    },
    "verify.ninsho-paseto.redis": {
      "group": "comparable",
      "checks": "Ed25519 PASETO + claims + Redis EXISTS denylist."
    },
    "verify.jwt-redis.redis": {
      "group": "comparable",
      "checks": "jose EdDSA JWT + claims + Redis EXISTS denylist."
    },
    "verify.ninsho-paseto.no-revocation": {
      "group": "reference",
      "checks": "Ed25519 PASETO + claims; revocation check skipped (skipRevocationCheck). NOT the default path."
    },
    "verify.jwt-stateless": {
      "group": "reference",
      "checks": "jose EdDSA JWT + claims; no revocation check."
    },
    "verify.ninsho-opaque.memory": {
      "group": "reference",
      "checks": "Opaque verify against in-process MemoryStore (CPU cost without a network hop)."
    }
