{
  "name": "@ninsho/webauthn",
  "version": "0.1.0",
  "description": "WebAuthn / passkey registration and authentication verification for Ninsho. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ninsho",
    "webauthn",
    "passkey",
    "fido2",
    "authentication"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "dependencies": {
    "@ninsho/core": "0.1.0"
  },
  "devDependencies": {
    "@ninsho/server": "0.1.0"
  }
}
