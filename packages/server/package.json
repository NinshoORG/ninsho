{
  "name": "@ninsho/server",
  "version": "0.1.0",
  "description": "Ninsho authentication engine for Node.js — opaque or PASETO tokens, injected session store, secure by default.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./koa": {
      "import": {
        "types": "./dist/koa.d.ts",
        "default": "./dist/koa.js"
      },
      "require": {
        "types": "./dist/koa.d.cts",
        "default": "./dist/koa.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/bench.ts"
  },
  "dependencies": {
    "@ninsho/core": "0.1.0",
    "ioredis": "^5.4.2"
  },
  "keywords": [
    "ninsho",
    "authentication",
    "session",
    "paseto",
    "revocation",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Djain912/ninsho.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Djain912/ninsho/issues"
  },
  "homepage": "https://github.com/Djain912/ninsho#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@koa/router": "^13.1.1",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.5",
    "fastify": "^5.2.1",
    "hono": "^4.13.5",
    "koa": "^2.16.4"
  }
}
