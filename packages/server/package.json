{
  "name": "@ninsho/server",
  "version": "0.1.0",
  "description": "Ninsho authentication engine for Node.js \u2014 opaque or PASETO tokens, injected session store, secure by default.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/bench.ts"
  },
  "dependencies": {
    "@ninsho/core": "0.1.0",
    "ioredis": "^5.4.2"
  },
  "keywords": [
    "ninsho",
    "authentication",
    "session",
    "paseto",
    "revocation",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "fastify": "^5.2.1"
  }
}
