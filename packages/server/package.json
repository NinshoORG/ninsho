{
  "name": "@ninshorg/server",
  "version": "0.1.0",
  "description": "Ninsho authentication engine for Node.js — opaque or PASETO tokens, injected session store, secure by default.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./koa": {
      "import": {
        "types": "./dist/koa.d.ts",
        "default": "./dist/koa.js"
      },
      "require": {
        "types": "./dist/koa.d.cts",
        "default": "./dist/koa.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --experimental-strip-types bench/bench.ts"
  },
  "dependencies": {
    "@ninshorg/core": "0.1.0",
    "ioredis": "^6.0.0"
  },
  "keywords": [
    "ninsho",
    "authentication",
    "session",
    "paseto",
    "revocation",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NinshoORG/ninsho.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/NinshoORG/ninsho/issues"
  },
  "homepage": "https://github.com/NinshoORG/ninsho#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@koa/router": "^15.7.0",
    "@types/koa": "^3.0.3",
    "fastify": "^5.12.3",
    "hono": "^4.13.7",
    "koa": "^3.2.1"
  }
}
