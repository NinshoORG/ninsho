{
  "name": "@ninsho/core",
  "version": "0.1.0",
  "description": "Shared types, errors, and cryptographic primitives for Ninsho. Zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "ninsho",
    "authentication",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false
}
